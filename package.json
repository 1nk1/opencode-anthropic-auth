{
  "name": "@1nk1/opencode-anthropic-auth",
  "version": "2.0.0-beta.6",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "1nk1",
    "email": "andrey.pagosov@gmail.com"
  },
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "keywords": [
    "opencode",
    "opencode2",
    "anthropic",
    "claude",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1nk1/opencode-anthropic-auth"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "tag": "beta"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "bun run verify && bun run build && bun run scan:unicode-stego --require-text dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun scripts/dev.ts",
    "dev:clean": "bun scripts/dev-clean.ts",
    "extract": "bun scripts/extract-system-prompt.ts",
    "test": "bun test",
    "test:live-models": "bun scripts/live-model-smoke.ts",
    "types": "tsc",
    "format": "biome check --write --unsafe",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "audit": "bun audit --audit-level=high",
    "scan:unicode-stego": "bun scripts/scan-unicode-stego.ts",
    "verify": "bun test && bun run types && bun run lint && bun run format:check && bun run audit && bun run scan:unicode-stego"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18866",
    "@streamparser/json": "0.0.26"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "dedent": "^1.7.2",
    "lefthook": "2.1.9",
    "typescript": "6.0.3"
  }
}
